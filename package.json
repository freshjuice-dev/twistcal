{
  "name": "@freshjuice/twistcal",
  "version": "0.2.0-beta.1",
  "type": "module",
  "description": "Lightweight zero-dependency Add to Calendar web component with Shadow DOM",
  "main": "dist/twistcal.min.js",
  "module": "dist/twistcal.esm.min.js",
  "exports": {
    ".": {
      "import": "./dist/twistcal.esm.min.js",
      "default": "./dist/twistcal.min.js"
    },
    "./slim": {
      "import": "./dist/twistcal.slim.esm.min.js",
      "default": "./dist/twistcal.slim.min.js"
    },
    "./generators": {
      "import": "./dist/twistcal.generators.esm.min.js",
      "default": "./dist/twistcal.generators.min.js"
    },
    "./src/*": "./src/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "node server.js",
    "prebuild": "node scripts/build-langs.js",
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "node --test test/*.test.mjs",
    "size": "gzip-size dist/twistcal.min.js"
  },
  "keywords": [
    "calendar",
    "add-to-calendar",
    "ics",
    "icalendar",
    "google-calendar",
    "outlook",
    "yahoo-calendar",
    "web-component",
    "custom-element",
    "shadow-dom",
    "zero-dependency",
    "calendar-deeplink"
  ],
  "author": {
    "name": "FreshJuice",
    "email": "contact@freshjuice.dev",
    "url": "https://freshjuice.dev/"
  },
  "contributors": [
    {
      "name": "Alex Zappa",
      "email": "alex@zappa.dev",
      "url": "https://alex.zappa.dev/"
    }
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.62.4"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/freshjuice-dev/twistcal.git"
  },
  "homepage": "https://twistcal.com",
  "bugs": {
    "url": "https://github.com/freshjuice-dev/twistcal/issues"
  }
}